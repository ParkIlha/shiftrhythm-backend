# docker compose 용 환경변수. 이 파일을 .env 로 복사해서 쓴다.
#
#   cp .env.example .env
#   # .env 의 ANTHROPIC_API_KEY 를 실제 키로 교체
#   docker compose up -d --build
#
# .env 는 .gitignore 에 있어서 커밋되지 않는다.

# --- DB ---
# docker-compose.yml 에 같은 값이 기본값으로 박혀 있어서 없어도 돌아간다.
# 값을 바꾸고 싶을 때만 건드리면 된다.
DB_ROOT_PASSWORD=root
DB_NAME=shiftrhythm
DB_USERNAME=shiftrhythm
DB_PASSWORD=shiftrhythm

# --- AI 서버 (Anthropic) ---
# 이것만 기본값이 없다. 비어 있으면 ai-server 에 빈 키가 들어가서 AI 호출이 전부 실패한다.
ANTHROPIC_API_KEY=sk-ant-xxx

# 모델 덮어쓰기 (선택)
# AI_MODEL_VISION=claude-sonnet-5
# AI_MODEL_FAST=claude-haiku-4-5-20251001
